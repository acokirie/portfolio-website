---
interface Props {

eyebrow?:string;

title:string;

description?:string;

align?: "center" | "left";

}

const {
 eyebrow,
 title,
 description,
 align="center"
}=Astro.props;

---

<div class={`section-header ${align}`}>

  <!-- {eyebrow && <p class="eyebrow">{eyebrow}</p>}  No need for it -->

  <h2>{title}</h2>

  {description && <p class="description">{description}</p>}

</div>

<style>
.section-header{
  max-width:700px;
  margin:0 auto var(--space-6);
  /* text-align:center; */
}

.eyebrow{
  margin:0 0 .75rem;
  color:var(--blue);
  text-transform:uppercase;
  letter-spacing:.12rem;
  font-size:var(--text-xs);
  font-weight:var(--weight-bold);
}

h2{
  margin:0 0 1rem;
  color:var(--navy);
  font-size:clamp(2rem,4vw,3rem);
  line-height:1.15;
}

.description{
  margin:0;
  color:var(--muted);
  font-size:var(--text-md);
  line-height:1.7;
}

.center{

margin-left:auto;
margin-right:auto;
text-align:center;

}


.left{

text-align:left;

}
</style>