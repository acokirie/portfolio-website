---
interface Props {
  variant?: "default" | "dark" | "featured";
}

const {
  variant = "default"
} = Astro.props;
---

<div class={`card ${variant}`}>
  <slot />
</div>


<style>

.card {

  display:flex;
  flex-direction:column; /* Pushes the CTA to the Bottom */

  padding:var(--space-4);

  background:var(--white);

  border:1px solid var(--card-color, var(--border));

  border-radius:var(--radius-lg);

  box-shadow:var(--shadow-sm);


  transition:
    transform var(--transition),
    box-shadow var(--transition),
    border-color var(--transition);

}


.card:hover {

  transform:translateY(-6px);

  box-shadow:var(--shadow-lg);

  border-color:var(--card-color-hover, var(--border));

}


/* optional future theme */

.dark {

  background:var(--navy);

  border-color:transparent;

}


.featured {

  border-top:4px solid var(--color-suit-mustard);

}


</style>