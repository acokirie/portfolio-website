---
import Card from "./Card.astro";

interface Props {
  category: string;
  title: string;
  summary: string;
  href: string;
  tags?: string[];
  cover?: string;
}

const { category, title, summary, href, tags = [], cover } = Astro.props;
---

<Card>
  {cover && <img src={cover} alt={title} class="cover" />}

  <p class="company">{category}</p>

  <h3>{title}</h3>

  <p class="summary">{summary}</p>

  <div class="badges">
    {tags.map((tag) => (
      <span class="badge">{tag}</span>
    ))}
  </div>

  <a class="link" href={href}>
    Read Article →
  </a>
</Card>

<style>
  .cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin: calc(var(--space-4) * -1) calc(var(--space-4) * -1) var(--space-3);
    width: calc(100% + var(--space-4) * 2);
    max-width: none;
  }

  .company {
    margin: 0;
    color: var(--navy);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: .08rem;
  }

  h3 {
    margin: .75rem 0 1rem;
    color: var(--blue);
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .summary {
    margin: 0 0 1.5rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: 2rem;
  }

  .badge {
    padding: .35rem .8rem;
    border-radius: 999px;
    background: var(--slate-100);
    color: var(--slate-600);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .link {
    display: inline-flex;
    align-items: center;
    margin-top: auto;
    color: var(--blue);
    font-weight: var(--weight-semibold);
  }

  .link:hover {
    color: var(--muted);
    font-weight: 800;
  }
</style>