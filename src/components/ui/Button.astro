---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  target?: string;
}

const {
  href,
  variant = "primary",
  target = "_self"
} = Astro.props;
---

<a
  href={href}
  target={target}
  class={`btn ${variant}`}
>
  <slot />
</a>

<style>
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: .9rem 1.6rem;

  border-radius: var(--radius-md);

  font-weight: 600;
  font-size: .95rem;

  transition: all .2s ease;

  cursor: pointer;
}

.primary {
  background: var(--gradient-primary);
  color: white;
  box-shadow: var(--shadow-md);
}

.primary:hover {
  transform: translateY(-2px);
}

.secondary {
  background: white;
  color: var(--navy);
  border: 1px solid var(--border);
}

.secondary:hover {
  background: var(--slate-50);
}
</style>