---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "tertiary";
  target?: string;
}

const {
  href,
  variant = "primary",
  target = "_self"
} = Astro.props;
---

<a
 href={href}
 target={target}
 rel={target === "_blank" ? "noopener noreferrer" : undefined}
 class={`btn ${variant}`}
>
  <slot />
</a>


