---
import Card from "./Card.astro";

interface Props {
  company: string;
  title: string;
  summary: string;
  href: string;
  metrics?: string[];
}

const {
  company,
  title,
  summary,
  href,
  metrics = []
} = Astro.props;
---

<Card>

  <p class="company">{company}</p>

  <h3>{title}</h3>

  <p class="summary">{summary}</p>

  <div class="badges">
    {metrics.map((metric) => (
      <span class="badge">{metric}</span>
    ))}
  </div>

  <a class="link" href={href}>
    Read Case Study →
  </a>

</Card>

<style>
.company{
  margin:0;
  color:var(--blue);
  font-size:var(--text-xs);
  font-weight:var(--weight-bold);
  text-transform:uppercase;
  letter-spacing:.08rem;
}

h3{
  margin:.75rem 0 1rem;
  color:var(--navy);
  font-size:1.5rem;
  line-height:1.3;
}

.summary{
  margin:0 0 1.5rem;
  color:var(--muted);
  line-height:1.7;
}

.badges{
  display:flex;
  flex-wrap:wrap;
  gap:.5rem;
  margin-bottom:2rem;
}

.badge{
  padding:.35rem .8rem;
  border-radius:999px;
  background:var(--slate-100);
  color:var(--slate-600);
  font-size:var(--text-xs);
  font-weight:var(--weight-medium);
}

.link{
  display:inline-flex;
  align-items:center;

  margin-top:auto;

  color:var(--blue);
  font-weight:var(--weight-semibold);
}

.link:hover{
  color:var(--color-suit-mustard);

}

.case-study-card{
  height:100%;
}

</style>