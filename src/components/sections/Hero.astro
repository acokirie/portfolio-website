.portrait img{
  width:100%;
  aspect-ratio:4/5;

  object-fit:cover;

  border-radius:20px;

  display:block;
}
@media (max-width: 900px) {

.grid{

grid-template-columns:1fr;

}

.portrait{

order:-1;

}

}
</style>