---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<section class="hero">

  <Container>

    <div class="grid">

      <div class="content">

        <p class="eyebrow">
          Senior Program Manager • Technical Program Manager
        </p>

        <h1>
          Building enterprise systems that scale operations,
          technology, and business.
        </h1>

        <p class="lead">
          PMP, CSM, and MBA leader with experience across Amazon,
          Lowe's, Walmart, and Procter & Gamble, delivering complex
          programs that improve operational performance, reduce cost,
          and enable enterprise growth.
        </p>

        <div class="actions">

          <Button href="/portfolio">
            Portfolio
          </Button>

          <Button
            href="/resume"
            variant="secondary"
          >
            Resume
          </Button>

        </div>

      </div>

      <div class="portrait">

        <img
          src="/images/adaku-headshot.png"
          alt="Adaku Okirie"
        />

      </div>

    </div>

  </Container>

</section>

<style>

.hero {
  position: relative;
  overflow: hidden;
  padding: 7rem 0;   /* existing padding still gives generous top space */
  margin-top: -5.5rem;   /* pull back up under the nav */
 
  background: var(--gradient-subtle-cream);
  /* background: var(--color-backdrop-dark); */

  /* full-bleed: break out of any parent container */
  width: 100vw;
  margin-left: 50%;
  transform: translateX(-50%);
}

.hero::before {
  content: "";

  position: absolute;

  inset: 0;

  background:
    radial-gradient(circle at top right,
      rgba(37,99,235,.12),
      transparent 45%);
}

.grid {
  position: relative;

  display: grid;

  gap: 5rem;

  align-items: center;

  grid-template-columns: 1.2fr .8fr;
}

.eyebrow {
  color: var(--blue);

  text-transform: uppercase;

  font-weight: 700;

  letter-spacing: .12rem;

  margin-bottom: 1rem;
}

h1 {
  font-size: clamp(3rem, 6vw, 4.8rem);

  line-height: 1.05;

  margin-bottom: 2rem;

  color: var(--navy);
  /* color: var(--color-backdrop-light); */
}

.lead {
  font-size: 1.2rem;

  /* color: var(--muted); */

  max-width: 42rem;

  margin-bottom: 2.5rem;
}

.actions {
  display: flex;

  gap: 1.25rem; /* breathing room */
  margin-top:2.5rem;

  flex-wrap: wrap;
}

.portrait{
  display:flex;
  justify-content:center;
  align-items:center;
}

