---
import SectionHeader from "../ui/SectionHeader.astro";
import CaseStudyCard from "../ui/CaseStudyCard.astro";
import Button from "../ui/Button.astro";
---

<section class="portfolio">

  <SectionHeader
    eyebrow="Portfolio"
    title="Selected Program Leadership"
    description="Enterprise programs spanning operations, supply chain, fulfillment, and technology."
  />

  <div class="grid">

    <CaseStudyCard
      company="Amazon"
      title="Fulfillment Network Optimization"
      summary="Improved throughput, execution consistency, and operational performance across a high-volume fulfillment environment."
      href="/portfolio/amazon"
      metrics={["Operations","Supply Chain","Analytics"]}
    />

    <CaseStudyCard
      company="Lowe's"
      title="Transportation Performance Improvement"
      summary="Reduced execution risk through KPI governance, planning optimization, and transportation process improvements."
      href="/portfolio/lowes"
      metrics={["Transportation","Planning","KPIs"]}
    />

    <CaseStudyCard
      company="Walmart"
      title="Operational Excellence"
      summary="Led cross-functional initiatives focused on execution quality, workforce performance, and customer outcomes."
      href="/portfolio/walmart"
      metrics={["Leadership","Operations","Execution"]}
    />

  </div>

  <div class="cta">
    <Button href="/portfolio" variant="secondary">
      View All Case Studies
    </Button>
  </div>

</section>

<style>
.portfolio{
  background:var(--slate-50);

  width:100vw;
  margin-left:50%;
  transform:translateX(-50%);

  padding:var(--space-7) 0;
}

.grid{
  width:min(var(--container),calc(100% - 3rem));
  margin:0 auto;

  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:var(--space-4);
}

.cta{
  margin-top:var(--space-6);
  display:flex;
  justify-content:center;
}

@media (max-width:900px){

  .grid{
    grid-template-columns:1fr;
  }

}
</style>