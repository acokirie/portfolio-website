---
import Card from "../ui/Card.astro";
---

<section class="impact">

    <Card>
    <h2>$12M+</h2>
    <p>Operational Value Created</p>
  </Card>

  <Card>
    <h2>20+</h2>
    <p>Enterprise Programs Led</p>
  </Card>

  <Card>
    <h2>120</h2>
    <p>Associates Led</p>
  </Card>

</section>

<style>
.impact{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:var(--space-4);
  margin:var(--space-7) 0;
}

.impact :global(.card){
  text-align:center;
}

.impact h2{
  margin:0;
  font-size:var(--text-2xl);
  font-weight:var(--weight-bold);
  color:var(--navy);
}

.impact p{
  margin-top:.75rem;
  color:var(--muted);
  font-size:var(--text-md);
}

@media (max-width:900px){
  .impact{
    grid-template-columns:1fr;
  }
}
</style>