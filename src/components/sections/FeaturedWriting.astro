---
import { getCollection } from "astro:content";
import SectionHeader from "../ui/SectionHeader.astro";
import WritingCard from "../ui/WritingCard.astro";
import Button from "../ui/Button.astro";

const posts = await getCollection("blog", ({ data }) => {
  return data.featured === true && data.draft === false;
});

const featuredPosts = posts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section class="featured-writing full-bleed">
  <div class="container">
    <SectionHeader
      title="Featured Writing"
      description="Thoughts on program management, operations, and enterprise systems."
      align="center"
    />

    <div class="grid">
      {featuredPosts.map((post) => (
        <WritingCard
          category={post.data.category}
          title={post.data.title}
          summary={post.data.description}
          tags={post.data.tags}
          cover={post.data.cover}
          href={`/writing/${post.slug}`}
        />
      ))}
    </div>

    <div class="cta">
      <Button href="/writing" variant="primary">View All Articles →</Button>
    </div>
  </div>
</section>

<style>
  .featured-writing {
    /* background: var( --gradient-subtle-cream);  commented out because I want the background color to be default white*/
  }

  .container {
    width: min(1200px, 90%);
    margin: auto;
  }


  .grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: var(--space-5);
}
  .cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-6);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>