---
import Navigation from "../components/Navigation.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />

	<link rel="icon" href="/favicon.ico" />

	<title>{title}</title>
</head>

<body>

	<Navigation />

	<main class="container">
		<slot />
	</main>

</body>

</html>

<style>

:root{

	--primary:#0F172A;
	--accent:#0EA5E9;
	--background:#FFFFFF;
	--text:#1F2937;
	--shadow1: rgba(15,23,42,.12);
	--shadow2: rgba(15,23,42,.08);

}

*{

	box-sizing:border-box;

}

body{

	margin:0;

	font-family:
		Inter,
		system-ui,
		sans-serif;

	background:var(--background);

	color:var(--text);

}

.container{

	max-width:1100px;

	margin:auto;

	padding:2rem;

}

</style>





