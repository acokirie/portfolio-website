---
import Navigation from "../components/Navigation.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />

	<link rel="icon" href="/favicon.ico" />

	<title>{title}</title>
</head>

<body>

	<Navigation />

	<main class="container">
		<slot />
	</main>

</body>

</html>

<style>

:root{

    /* Brand */

    --primary:#0F172A;
    --accent:#0EA5E9;

    /* Surface */

    --background:#FFFFFF;
    --surface:#FFFFFF;

    /* Typography */

    --text:#1F2937;
    --text-muted:#6B7280;

    /* Borders */

    --border:#E5E7EB;

    /* Elevation */

    --shadow-sm:
        0 4px 12px rgba(15,23,42,.06);

    --shadow-md:
        0 12px 24px rgba(15,23,42,.12),
        0 24px 48px rgba(15,23,42,.08);

    /* Radius */

    --radius-sm:8px;
    --radius-md:12px;
    --radius-lg:20px;

    /* Spacing (coming soon) */

    --space-1:.5rem;
    --space-2:1rem;
    --space-3:2rem;
    --space-4:4rem;

}



