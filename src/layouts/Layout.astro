---
import "../styles/globals.css";
import Navigation from "../components/sections/Navigation.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Senior Program Manager | Technical Program Manager | AI | Supply Chain | Operations"
} = Astro.props;
---

<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />

  <link rel="icon" href="/favicon.ico" />

  <title>{title}</title>
</head>
	<Navigation />

<body>



	<main>
		<slot />
	</main>

</body>

</html>

